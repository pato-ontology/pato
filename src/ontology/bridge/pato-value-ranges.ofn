Ontology(<http://purl.obolibrary.org/obo/pato/bridge/pato-value-ranges.owl>
Annotation(dct:title "PATO value ranges: numeric definitions of value classes (proposal; OWL 2 DL bridge, not part of the PATO build)"@en)
Annotation(rdfs:comment "Proposal accompanying a pull request from FLOPO. Form A: a value defined by a count is equivalent to that count. Form B: a bearer with a measured attribute in the stated range has the value (a sufficient condition from a named source; the value is not restricted to the range). Kept apart from pato.owl because OWL 2 EL has no data-range facets. Placeholders: the data properties obo:FLOPO_0995001 (has number of parts per node) and obo:FLOPO_0995002 (has number of rows), the annotation property obo:FLOPO_0995003 (has neighbouring value) and the magnitude property of the FLOPO annotation model; PATO:0104368 (ovate, plane) is the class of pull request 627. Generated from the FLOPO repository (tools/build_flopo_value_space_extension.py)."@en)

Declaration(AnnotationProperty(:observedRange))
AnnotationAssertion(rdfs:label :observedRange "range used in the annotated floras")
AnnotationAssertion(obo:IAO_0000115 :observedRange "The middle 80% of the length to width ratios in flora descriptions that give a blade length, a blade width and this one shape word (99,412 annotated descriptions, 2026-11-21). A record of usage, not a definition."@en)
Declaration(AnnotationProperty(:secondReading))
AnnotationAssertion(rdfs:label :secondReading "reading of the 1962 Systematics Association chart")
AnnotationAssertion(obo:IAO_0000115 :secondReading "What Systematics Association Committee for Descriptive Biological Terminology. II. Terminology of simple symmetrical plane shapes (Chart 1). Taxon 1962;11(5):145-156. doi:10.2307/1216718 gives for the same word."@en)
Declaration(AnnotationProperty(:proposedDefinition))
AnnotationAssertion(rdfs:label :proposedDefinition "definition proposed to PATO")
Declaration(ObjectProperty(obo:RO_0000053))
Declaration(DataProperty(ann:has_magnitude))
FunctionalDataProperty(ann:has_magnitude)
Declaration(DataProperty(obo:FLOPO_0995001))
AnnotationAssertion(rdfs:label obo:FLOPO_0995001 "has number of parts per node")
FunctionalDataProperty(obo:FLOPO_0995001)
DataPropertyDomain(obo:FLOPO_0995001 obo:PATO_0000001)
DataPropertyRange(obo:FLOPO_0995001 DatatypeRestriction(xsd:integer xsd:minInclusive "1"^^xsd:integer))
Declaration(DataProperty(obo:FLOPO_0995002))
AnnotationAssertion(rdfs:label obo:FLOPO_0995002 "has number of rows")
FunctionalDataProperty(obo:FLOPO_0995002)
DataPropertyDomain(obo:FLOPO_0995002 obo:PATO_0000001)
DataPropertyRange(obo:FLOPO_0995002 DatatypeRestriction(xsd:integer xsd:minInclusive "1"^^xsd:integer))
Declaration(Class(obo:PATO_0000001)) AnnotationAssertion(rdfs:label obo:PATO_0000001 "quality")
Declaration(Class(obo:PATO_0104370)) AnnotationAssertion(rdfs:label obo:PATO_0104370 "length to width ratio")
SubClassOf(obo:PATO_0104370 obo:PATO_0001470)
Declaration(Class(obo:PATO_0104371)) AnnotationAssertion(rdfs:label obo:PATO_0104371 "relative position of the widest point")
SubClassOf(obo:PATO_0104371 obo:PATO_0000140)
Declaration(Class(obo:PATO_0104372)) AnnotationAssertion(rdfs:label obo:PATO_0104372 "apex angle")
SubClassOf(obo:PATO_0104372 obo:PATO_0002326)
Declaration(Class(obo:PATO_0104373)) AnnotationAssertion(rdfs:label obo:PATO_0104373 "base angle")
SubClassOf(obo:PATO_0104373 obo:PATO_0002326)

# --- form A: values defined by a count -------------------------------------------
Declaration(Class(obo:PATO_0001932)) AnnotationAssertion(rdfs:label obo:PATO_0001932 "alternate placement")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 2.1.") :proposedDefinition obo:PATO_0001932 "An arrangement quality inhering in an axis by virtue of the axis bearing one part of the kind concerned at each node.")
EquivalentClasses(obo:PATO_0001932 DataHasValue(obo:FLOPO_0995001 "1"^^xsd:integer))
Declaration(Class(obo:PATO_0001933)) AnnotationAssertion(rdfs:label obo:PATO_0001933 "opposite")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 2.3.") :proposedDefinition obo:PATO_0001933 "An arrangement quality inhering in an axis by virtue of the axis bearing two parts of the kind concerned at each node, on opposite sides of the axis.")
EquivalentClasses(obo:PATO_0001933 DataHasValue(obo:FLOPO_0995001 "2"^^xsd:integer))
Declaration(Class(obo:PATO_0001951)) AnnotationAssertion(rdfs:label obo:PATO_0001951 "whorled")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 2.4.") :proposedDefinition obo:PATO_0001951 "An arrangement quality inhering in an axis by virtue of the axis bearing three or more parts of the kind concerned at each node.")
EquivalentClasses(obo:PATO_0001951 DataSomeValuesFrom(obo:FLOPO_0995001 DatatypeRestriction(xsd:integer xsd:minInclusive "3"^^xsd:integer)))

# --- form B: values that follow from a measured attribute of the same bearer ------
Declaration(Class(obo:PATO_0001199)) AnnotationAssertion(rdfs:label obo:PATO_0001199 "linear")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.5.") :proposedDefinition obo:PATO_0001199 "A shape quality inhering in a flat bearer by virtue of the bearer being at least 10 times as long as wide, wherever its widest point lies.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.5.") ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001199))
AnnotationAssertion(:observedRange obo:PATO_0001199 "length:width 4.74-61.10, median 17.32, n=4597")
AnnotationAssertion(:secondReading obo:PATO_0001199 "Chart 1, figure 12 (linearis): oblong series, parallel-sided, at 12:1; column 1 is not delimited outwards.")
Declaration(Class(obo:PATO_0001877)) AnnotationAssertion(rdfs:label obo:PATO_0001877 "lanceolate")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.3.") :proposedDefinition obo:PATO_0001877 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the proximal two-fifths of its length and at least 3 but less than 10 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.3.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "3"^^xsd:decimal xsd:maxExclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:maxInclusive "0.4"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001877))
AnnotationAssertion(:observedRange obo:PATO_0001877 "length:width 2.16-13.42, median 5.00, n=5613")
AnnotationAssertion(:secondReading obo:PATO_0001877 "Not in Chart 1: 'lanceolatus has been so variously used (principally for figures 2 and 37) ... It has become so imprecise in meaning that we have had to eliminate it from this scheme' (p. 146). Figure 2 is narrowly elliptic, figure 37 narrowly ovate, both in the column 6:1 to 3:1.")
Declaration(Class(obo:PATO_0002330)) AnnotationAssertion(rdfs:label obo:PATO_0002330 "oblanceolate")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.2.") :proposedDefinition obo:PATO_0002330 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the distal two-fifths of its length and at least 3 but less than 10 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.2.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "3"^^xsd:decimal xsd:maxExclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "0.6"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0002330))
AnnotationAssertion(:observedRange obo:PATO_0002330 "length:width 2.33-9.58, median 4.00, n=1654")
AnnotationAssertion(:secondReading obo:PATO_0002330 "Not in Chart 1 (eliminated with lanceolatus, p. 146); figures 45-46, anguste obovatus, 6:1 to 3:1.")
Declaration(Class(obo:PATO_0104368)) AnnotationAssertion(rdfs:label obo:PATO_0104368 "ovate")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.3.") :proposedDefinition obo:PATO_0104368 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the proximal two-fifths of its length and less than 10 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.3.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:maxExclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:maxInclusive "0.4"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0104368))
AnnotationAssertion(:secondReading obo:PATO_0104368 "Chart 1, figures 38-39 (ovatus): widest at one third of the length from the base, 2:1 to 3:2; narrower and broader shapes take anguste (6:1-3:1), late (6:5) and latissime.")
Declaration(Class(obo:PATO_0001936)) AnnotationAssertion(rdfs:label obo:PATO_0001936 "obovate")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.2.") :proposedDefinition obo:PATO_0001936 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the distal two-fifths of its length and less than 10 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.2.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:maxExclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "0.6"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001936))
AnnotationAssertion(:observedRange obo:PATO_0001936 "length:width 1.43-3.64, median 2.13, n=1533")
AnnotationAssertion(:secondReading obo:PATO_0001936 "Chart 1, figures 47-48 (obovatus): widest at one third of the length from the apex, 2:1 to 3:2.")
Declaration(Class(obo:PATO_0000947)) AnnotationAssertion(rdfs:label obo:PATO_0000947 "elliptic")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") :proposedDefinition obo:PATO_0000947 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the middle fifth of its length and more than 1.2 but less than 10 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minExclusive "1.2"^^xsd:decimal xsd:maxExclusive "10"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minExclusive "0.4"^^xsd:decimal xsd:maxExclusive "0.6"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0000947))
AnnotationAssertion(:observedRange obo:PATO_0000947 "length:width 1.63-4.08, median 2.39, n=6561")
AnnotationAssertion(:secondReading obo:PATO_0000947 "Chart 1, figures 3-4 (ellipticus): widest at the middle, 2:1 to 3:2.")
Declaration(Class(obo:PATO_0001934)) AnnotationAssertion(rdfs:label obo:PATO_0001934 "orbicular")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") :proposedDefinition obo:PATO_0001934 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the middle fifth of its length and 1 to 1.2 times as long as wide.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "1"^^xsd:decimal xsd:maxInclusive "1.2"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minExclusive "0.4"^^xsd:decimal xsd:maxExclusive "0.6"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001934))
AnnotationAssertion(:observedRange obo:PATO_0001934 "length:width 0.77-2.30, median 1.18, n=808")
AnnotationAssertion(:secondReading obo:PATO_0001934 "Chart 1, figure 6 (circularis, 1:1): 'we prefer circularis and subcircularis' to orbicularis (p. 147).")
Declaration(Class(obo:PATO_0000409)) AnnotationAssertion(rdfs:label obo:PATO_0000409 "oblate")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") :proposedDefinition obo:PATO_0000409 "A shape quality inhering in a flat bearer by virtue of the bearer being widest in the middle fifth of its length and wider than long.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10.1.") ObjectIntersectionOf(ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104370 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:maxExclusive "1"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104371 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minExclusive "0.4"^^xsd:decimal xsd:maxExclusive "0.6"^^xsd:decimal))))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0000409))
AnnotationAssertion(:secondReading obo:PATO_0000409 "Rejected in Chart 1: 'its use seems to be confined to English-speaking countries' (p. 147); the chart has transverse late ellipticus (5:6).")
Declaration(Class(obo:PATO_0001935)) AnnotationAssertion(rdfs:label obo:PATO_0001935 "obtuse")
AnnotationAssertion(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, characters 16 and 18.") :proposedDefinition obo:PATO_0001935 "A shape quality inhering in the apex or base of a flat bearer by virtue of its margins meeting at an angle of 90 degrees or more and less than 180 degrees.")
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, characters 16 and 18.") ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104372 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "90"^^xsd:decimal xsd:maxExclusive "180"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001935))
SubClassOf(Annotation(dct:source "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, characters 16 and 18.") ObjectSomeValuesFrom(obo:RO_0000053 ObjectIntersectionOf(obo:PATO_0104373 DataSomeValuesFrom(ann:has_magnitude DatatypeRestriction(xsd:decimal xsd:minInclusive "90"^^xsd:decimal xsd:maxExclusive "180"^^xsd:decimal)))) ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0001935))

