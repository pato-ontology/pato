AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001776> "immune cell homeostasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001776> "leucocyte homeostasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0001776> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0001776> "GO:0001776")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0001776> "Note that this term represents the return of immune system cell levels to stable numbers following an immune response as well as the proliferation and elimination of cells of the immune system required to maintain stable numbers in the absence of an outside stimulus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0001776> "leukocyte homeostasis")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0001776> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048872> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0012003> <http://purl.obolibrary.org/obo/CL_0000738>)))
