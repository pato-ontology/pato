EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0009887> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0009653> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002298> <http://purl.obolibrary.org/obo/UBERON_0000062>)))
