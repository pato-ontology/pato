AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0014902> "GO:0014902")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0014902> "myotube differentiation")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0014902> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0030154> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002315> <http://purl.obolibrary.org/obo/CL_0002372>)))
