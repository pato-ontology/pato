AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22505934") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33605520") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39223427") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0005604> "A collagen-containing extracellular matrix consisting of a thin layer of dense material found in various animal tissues interposed between the cells and the adjacent connective tissue. It consists of the basal lamina plus an associated layer of reticulin fibers.")
