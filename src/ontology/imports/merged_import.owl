AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0043588> "skin development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0043588> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0002097>)))
