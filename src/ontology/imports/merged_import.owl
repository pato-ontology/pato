# Class: <http://purl.obolibrary.org/obo/UBERON_0006756> (median lingual swelling)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Tuberculum_impar") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0006756> "During the third week of embryological development there appears, immediately behind the ventral ends of the two halves of the mandibular arch, a rounded swelling named the tuberculum impar, which was described by His as undergoing enlargement to form the buccal part of the tongue. More recent researches, however, show that this part of the tongue is mainly, if not entirely, developed from a pair of lateral swellings which rise from the inner surface of the mandibular arch and meet in the middle line. The site of their meeting remains post-embryonically as the median sulcus of the tongue. The tuberculum impar is said to form the central part of the tongue immediately in front of the foramen cecum, but Hammar insists that it is purely a transitory structure and forms no part of the adult tongue[WP, Gray's].")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "EHDAA2:0001081")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "EMAPA:17187")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "FMA:312476")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "SCTID:308821003")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "VHOG:0000730")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0006756> "Wikipedia:Tuberculum_impar")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "EHDAA2:0001081") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006756> "median lingual swelling")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://emedicine.medscape.com/article/845125-overview") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006756> "median tongue bud")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006756> "tuberculum impar")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Tuberculum_impar") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006756> "tuberculum linguale mediale")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0006756> "UBERON:0006756")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0006756> "The thyroid initially develops caudal to the tuberculum impar . This embryonic swelling arises from the first pharyngeal arch and occurs midline on the floor of the developing pharynx, eventually helping form the tongue as the 2 lateral lingual swellings overgrow it. [http://emedicine.medscape.com/article/845125-overview]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0006756> "median lingual swelling")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0006756> <http://purl.obolibrary.org/obo/UBERON_0002050>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0006756> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0006260>))
