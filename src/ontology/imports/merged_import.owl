AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0021563> "CN IX development")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0021563> "GO:0021563")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021563> "glossopharyngeal nerve development")
