EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0000240> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000079> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000486>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0002254>)))
