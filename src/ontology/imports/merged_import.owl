AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0014020> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0014020> "neural rod cavitation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0014020> "GO:0014020")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0014020> "primary neural tube formation")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0014020> <http://purl.obolibrary.org/obo/GO_0001838>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0014020> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0001841>))
