AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021718> "superior olivary nucleus development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0021718> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0007247>)))
