AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CL:0000056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ef") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0014872> "The process resulting in the physical partitioning and separation of a myoblast into daughter cells. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.")
