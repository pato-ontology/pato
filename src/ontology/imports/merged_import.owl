ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0015008> <http://purl.obolibrary.org/obo/PATO_0000001>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0015009> (similar in magnitude relative to)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0015009> "q1 similar_in_magnitude_relative_to q2 if and only if magnitude(q1) =~ magnitude(q2). Here, magnitude(q) is a function that maps a quality to a unit-invariant scale.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0015009> "similar in magnitude relative to")

