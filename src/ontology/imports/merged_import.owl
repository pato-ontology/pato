# Class: <http://purl.obolibrary.org/obo/GO_0021575> (hindbrain morphogenesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000021") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0021575> "The process in which the anatomical structure of the hindbrain is generated and organized. The hindbrain is the region consisting of the medulla, pons and cerebellum. Areas of the hindbrain control motor and autonomic functions.")
