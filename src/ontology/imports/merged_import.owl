AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0050975> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0050975> "GO:0050975")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0050975> "sensory perception of touch")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0050975> <http://purl.obolibrary.org/obo/GO_0050954>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0050975> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_33208>))

