AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chebi") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_51371> "muscle relaxants")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_51371> "CHEBI:51371")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CHEBI_51371> <http://purl.obolibrary.org/obo/chebi/3_STAR>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_51371> "muscle relaxant")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_51371> <http://purl.obolibrary.org/obo/CHEBI_51372>)

