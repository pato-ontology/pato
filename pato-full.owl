    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0003009">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0006936"/>
                    <owl:Restriction>
