        <oboInOwl:hasDbXref>GOC:ems</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mah</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:vw</oboInOwl:hasDbXref>
