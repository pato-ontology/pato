    <!-- http://purl.obolibrary.org/obo/PATO_0104352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer being flat and having two approximately triangular basal lobes directed outward to either side of the main axis.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104352</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985002. Distinguished from arrow-shaped (PATO:0001881; synonym sagittate), whose basal lobes point backward rather than outward.</rdfs:comment>
        <rdfs:label>hastate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A shape quality inhering in a bearer by virtue of the bearer being flat and having two approximately triangular basal lobes directed outward to either side of the main axis.</owl:annotatedTarget>
