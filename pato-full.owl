        <oboInOwl:hasExactSynonym>sinoatrial node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sinu-atrial node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sinuatrial nodal muscle tissue</oboInOwl:hasExactSynonym>
