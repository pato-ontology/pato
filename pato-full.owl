        <oboInOwl:hasExactSynonym>sense of taste</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>taste</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>taste perception</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0050909</oboInOwl:id>
        <rdfs:label>sensory perception of taste</rdfs:label>
    </owl:Class>
