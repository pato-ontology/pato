        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002315"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0008002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized features of a skeletal muscle fiber cell. Skeletal muscle fiber differentiation starts with myoblast fusion and the appearance of specific cell markers (this is the cell development step). Then individual skeletal muscle fibers fuse to form bigger myotubes and start to contract.</obo:IAO_0000115>
        <oboInOwl:created_by>dos</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-10-15T14:00:34Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0098528</oboInOwl:id>
        <rdfs:label>skeletal muscle fiber differentiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0098528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which a relatively unspecialized cell acquires specialized features of a skeletal muscle fiber cell. Skeletal muscle fiber differentiation starts with myoblast fusion and the appearance of specific cell markers (this is the cell development step). Then individual skeletal muscle fibers fuse to form bigger myotubes and start to contract.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dos</oboInOwl:hasDbXref>
    </owl:Axiom>
    


