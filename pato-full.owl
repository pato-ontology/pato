    <!-- http://purl.obolibrary.org/obo/PATO_0104355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002481"/>
        <obo:IAO_0000115>An oblique orientation quality inhering in a bearer by virtue of the bearer being directed gradually upward at an oblique angle.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104355</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985005. Some sources restrict ascending to a bearer with an initially horizontal or spreading base; that restriction is not part of this definition.</rdfs:comment>
        <rdfs:label>ascending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An oblique orientation quality inhering in a bearer by virtue of the bearer being directed gradually upward at an oblique angle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000133"/>
        <obo:IAO_0000115>An orientation quality inhering in a bearer by virtue of the bearer being directed outward and diverging from a principal axis.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104356</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985006. Distinguished from radiating (PATO:0005005), which requires expansion from a centre point, and from divergent from (PATO:0002424), which inheres in a bearer whose parts extend in different directions. Not a relational quality: like ascending and the other orientation qualities, spreading describes the direction of the bearer itself within its frame of reference (the axis from which it arises), and does not relate the bearer to a second, independent entity.</rdfs:comment>
        <rdfs:label>spreading</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104356"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An orientation quality inhering in a bearer by virtue of the bearer being directed outward and diverging from a principal axis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000454"/>
        <obo:IAO_0000115>A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, somewhat matted and tangled trichomes that give a wool-like appearance.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>woolly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104357</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985007. Distinguished from tomentose (PATO:0002341), whose hairs are shorter, denser and more closely matted.</rdfs:comment>
        <rdfs:label>lanate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, somewhat matted and tangled trichomes that give a wool-like appearance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=939</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000454"/>
        <obo:IAO_0000115>A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, soft, slender, appressed trichomes that give a silk-like appearance.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>silky</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104358</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985008.</rdfs:comment>
        <rdfs:label>sericeous</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, soft, slender, appressed trichomes that give a silk-like appearance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001975"/>
        <obo:IAO_0000115>An edge shape quality inhering in a bearer by virtue of the bearer&apos;s edge being continuous and even, without teeth, lobes, or other incisions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>entire margin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104359</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985009. Narrower than unserrated (PATO:0001975): an entire edge also lacks lobes and crenations.</rdfs:comment>
        <rdfs:label>entire</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An edge shape quality inhering in a bearer by virtue of the bearer&apos;s edge being continuous and even, without teeth, lobes, or other incisions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000050"/>
        <obo:IAO_0000115>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being no more than one year.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>annual</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104360</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985010. Annual, biennial and perennial life span are absolute-duration qualities and together partition expected natural life span; the existing siblings increased, decreased and normal life span are relative-magnitude qualities. The synonym annual is RELATED because outside life-history descriptions the word denotes a yearly frequency.</rdfs:comment>
        <rdfs:label>annual life span</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being no more than one year.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=272</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.rhs.org.uk/advice/beginners-guide/glossary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000050"/>
        <obo:IAO_0000115>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being more than two years.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>perennial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104361</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985011. Absolute-duration quality; see annual life span (PATO:0104360) for the partition with biennial life span (PATO:0104367).</rdfs:comment>
        <rdfs:label>perennial life span</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being more than two years.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1182</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.rhs.org.uk/advice/beginners-guide/glossary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104362 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001786"/>
        <obo:IAO_0000115>A split quality inhering in a bearer by virtue of the bearer being divided, at least partially, by incisions into visibly distinct segments that may remain connected.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104362</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985012. Distinguished from cut (PATO:0001978), which requires regular, deep incisions, and from lobed (PATO:0001979). No incision-depth threshold is implied.</rdfs:comment>
        <rdfs:label>dissected</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A split quality inhering in a bearer by virtue of the bearer being divided, at least partially, by incisions into visibly distinct segments that may remain connected.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=D-E</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001435"/>
        <obo:IAO_0000115>An attachment quality inhering in a bearer by virtue of the bearer at least partially enclosing an axis to which it is attached.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasNarrowSynonym>amplexicaul</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104363</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#relational_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985013. Amplexicaul (a leaf base clasping the stem) is a narrower botanical use. Relational quality: the definition refers to a second entity, the axis to which the bearer is attached, so the term lives under attachment quality with sessile (sensu botany) (PATO:0001436) rather than under position.</rdfs:comment>
        <rdfs:label>clasping</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104363"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An attachment quality inhering in a bearer by virtue of the bearer at least partially enclosing an axis to which it is attached.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=C</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=467</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000150"/>
        <obo:IAO_0000115>A texture quality inhering in a bearer by virtue of the bearer being covered with a coarse, flour-like powder.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0104364</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985014. Some glossaries distinguish coarse mealy powder from fine farina (farinose); farinose is therefore not added as a synonym.</rdfs:comment>
        <rdfs:label>mealy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104364"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A texture quality inhering in a bearer by virtue of the bearer being covered with a coarse, flour-like powder.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=F-H</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=M-O</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001910"/>
        <obo:IAO_0000115>A folded quality inhering in a bearer by virtue of the bearer being folded back and forth longitudinally like a fan.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>pleated</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104365</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985015. A single longitudinal fold does not satisfy the definition.</rdfs:comment>
        <rdfs:label>plicate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A folded quality inhering in a bearer by virtue of the bearer being folded back and forth longitudinally like a fan.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=P</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000454"/>
        <obo:IAO_0000115>A pilosity quality inhering in a bearer by virtue of the bearer having tufts of long, soft hairs that tend to rub off as small wool-like masses.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasNarrowSynonym>flocculose</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cottony</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104366</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985016. Cottony does not by itself imply that the hairs rub off, so it is a related synonym only.</rdfs:comment>
        <rdfs:label>floccose</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pilosity quality inhering in a bearer by virtue of the bearer having tufts of long, soft hairs that tend to rub off as small wool-like masses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=F-H</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000050"/>
        <obo:IAO_0000115>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being more than one year and no more than two years.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-10-01T00:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>biennial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0104367</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0987000. Absolute-duration quality; see annual life span (PATO:0104360) for the partition with perennial life span (PATO:0104361). The synonym biennial is RELATED because outside life-history descriptions the word denotes a two-yearly frequency.</rdfs:comment>
        <rdfs:label>biennial life span</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A life span quality inhering in a bearer by virtue of the bearer&apos;s expected natural life span being more than one year and no more than two years.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.rhs.org.uk/advice/beginners-guide/glossary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that consists of two or more organisms, viruses, or viroids.</obo:IAO_0000115>
        <rdfs:comment>May be of the same or different species.</rdfs:comment>
        <rdfs:label xml:lang="en">collection of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000018"/>
        <obo:IAO_0000115 xml:lang="en">A collection of organisms, all of the same species, that live in the same place.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">It is sometimes difficult to define the physical boundaries of a population. In the case of sexually reproducing organisms, the individuals within a population have the potential to reproduce with one another during the course of their lifetimes. &apos;Community&apos;, as often used to describe a group of humans, is a type of population of organisms. 

Classes for population already  exist in IDO (&apos;organism population&apos;, IDO_0000509) and OBI (&apos;population&apos;, OBI_0000181). The definitions should be standardized across OBO Foundry ontologies and only one term used.</rdfs:comment>
        <rdfs:label xml:lang="en">population of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000029"/>
        <obo:IAO_0000115 xml:lang="en">A multi-species collection of organisms of at least two different species, living in a particular area. Must have at least two populations of different species as members.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Ecological community is defined broadly here, but includes both ecological interactions (inherited from parent term community) and spatial co-existence. It may be used to describe every organisms living in an area, but is often used to refer only to organisms of a particular taxon or guild (e.g., the plant community, the insect community, the herbivore community). The word community, as it often used to describe a group of humans living together, is a type of single-species collection of organisms, not an ecological community.</rdfs:comment>
        <rdfs:label xml:lang="en">ecological community</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000003">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0002003"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A quality that inheres in a population of organisms.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Includes qualities like population size, population growth rate, carrying capacity, immigration rate, emigration rate, fecundity, and death rate. A population quality may depend on the qualities of individual organisms in the population, but cannot be measured or described for a single organism. This term may be replaced by a PATO term.</rdfs:comment>
        <rdfs:label xml:lang="en">quality of a population</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PATO_0002003"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000002"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A quality that inheres in a community.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Includes qualities like diversity, species richness, stability, resilience, community structure, number of trophic levels. A community quality may depend on the qualities of individual organism in the community, but cannot be measured or described for a single individual.</rdfs:comment>
        <rdfs:label xml:lang="en">quality of an ecological community</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that has as parts two or more organisms, viruses, or viroids of the same species and no members of any other species.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">single-species collection of organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PCO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PCO_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/PCO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A collection of organisms that consists of two or more organisms from at least two species.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:label xml:lang="en">multi-species collection of organisms</rdfs:label>
    </owl:Class>
    


