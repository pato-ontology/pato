    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0001384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001377"/>
        <obo:IAO_0000115>A polyploidy quality inhering in a bearer by virtue of the bearer&apos;s containing six homologous sets of chromosomes.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
