    <!-- http://purl.obolibrary.org/obo/PATO_0020000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0020000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000047"/>
        <obo:IAO_0000115>A biological sex quality inhering in an individual based upon genotypic composition of sex chromosomes.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4148-4606"/>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0020000</oboInOwl:id>
        <rdfs:comment>Note that the chromosomal constitution of genotypic sex varies in different organisms. In human, we have XY, XX, though abnormal XXY, X0, XYY, and other combinations are possible.</rdfs:comment>
        <rdfs:label>genotypic sex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0020000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
