        <oboInOwl:hasRelatedSynonym>de novo ciliary basal body assembly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>multiciliation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>multiciliogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0097742</oboInOwl:id>
        <rdfs:label>de novo centriole assembly</rdfs:label>
    </owl:Class>
