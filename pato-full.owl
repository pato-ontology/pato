        <oboInOwl:hasDbXref>ISBN:0198506732</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0006996 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006996">
