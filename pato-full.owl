        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical reactions and pathways involving RNA transcribed from the mitochondrial genome and occurring in the mitochondrion.</owl:annotatedTarget>
