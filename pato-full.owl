     xmlns:subsets="http://purl.obolibrary.org/obo/ro/subsets#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/pato/pato-full.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/pato/releases/2026-11-01/pato-full.owl"/>
        <obo:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <dc:description>An ontology of characteristics (properties, attributes, or modifiers). These are intended to be used in combination with terms from other ontologies to construct characteristic-entity combinations that describe traits or phenotypes of organisms, chemicals, environments, and other entities.</dc:description>
        <dc:title>PATO - the Phenotype And Trait Ontology</dc:title>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/3.0/"/>
        <oboInOwl:default-namespace>quality</oboInOwl:default-namespace>
        <oboInOwl:hasOBOFormatVersion>1.2</oboInOwl:hasOBOFormatVersion>
        <owl:versionInfo>2026-11-01</owl:versionInfo>
    </owl:Ontology>
    


