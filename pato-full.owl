        <obo:IAO_0000115>An epithelial cell that has a flattened morphology.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-16T15:56:39Z</terms:date>
        <oboInOwl:hasDbXref>CALOHA:TS-1249</oboInOwl:hasDbXref>
