        <oboInOwl:hasDbXref>MIAA:0000100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12795</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362484004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001576</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000384</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sympathetic_nervous_system</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sympathetic nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sympathetic part of autonomic division of nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0000013</oboInOwl:id>
