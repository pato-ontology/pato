        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Oligodendrocytes are reportedly MDP-positive and CD4-negative.</rdfs:comment>
        <rdfs:label>oligodendrocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
