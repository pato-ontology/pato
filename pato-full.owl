    <!-- http://purl.obolibrary.org/obo/GO_0098535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0098535">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0097742"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
