                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0002453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A class of large neuroglial (macroglial) cells in the central nervous system. Form the insulating myelin sheath of axons in the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000962</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0709</oboInOwl:hasDbXref>
