        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The enlargement or overgrowth of all or part of an organ due to an increase in size (not length) of individual muscle fibers without cell division. In the case of skeletal muscle cells this happens due to the additional synthesis of sarcomeric proteins and assembly of myofibrils.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mtg_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>
    


