        <oboInOwl:hasDbXref>EHDAA:3769</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:9906</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:710</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000225</oboInOwl:hasDbXref>
