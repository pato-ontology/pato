        <obo:IAO_0000115>q characteristic of part of w if and only if there exists some p such that q inheres in p and p part of w.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">characteristic of part of</rdfs:label>
    </owl:ObjectProperty>
    


