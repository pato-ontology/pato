    <!-- http://purl.obolibrary.org/obo/PATO_0001431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115>An emergent molecular quality that arises by virtue of the bearer&apos;s disposition to exhibit molecular attraction to another entity in contact.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>adhesiveness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>stickiness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PATO:0001431</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#attribute_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#disposition_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#relational_slim"/>
        <rdfs:comment>The definition is general enough to cover adhesion arising from different kinds of chemical bonding/forces, although for PATO this term will most commonly used for cellular adhesion. See also GO:0031589 &quot;cell-substrate adhesion&quot;.</rdfs:comment>
        <rdfs:label>adhesivity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001431"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
