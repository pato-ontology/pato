    <!-- http://purl.obolibrary.org/obo/RO_0002604 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002604">
        <obo:IAO_0000115>x is the opposite of y if there exists some distance metric M, and there exists no z such as M(x,z) &lt;= M(x,y) or M(y,z) &lt;= M(y,x).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>RO:0002604</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>is_opposite_of</oboInOwl:id>
        <oboInOwl:is_class_level rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</oboInOwl:is_class_level>
        <oboInOwl:is_metadata_tag rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</oboInOwl:is_metadata_tag>
        <oboInOwl:shorthand>is_opposite_of</oboInOwl:shorthand>
        <rdfs:label>is opposite of</rdfs:label>
        <rdfs:label>is_opposite_of</rdfs:label>
    </owl:AnnotationProperty>
    


