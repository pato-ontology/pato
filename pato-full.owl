        <oboInOwl:hasDbXref>ZFA:0000204</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Esophagus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gullet</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oesophagus</oboInOwl:hasExactSynonym>
