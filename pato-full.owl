        <obo:IAO_0000115>A multiciliated epithelial cell located in the respiratory tract epithelium, characterized by a columnar shape and motile cilia on its apical surface. This cell develops through a highly orchestrated process, transitioning from a basal progenitor via an intermediate deuterosomal cell stage that generates centrioles essential for ciliogenesis.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-25T11:06:01Z</terms:date>
        <oboInOwl:hasExactSynonym>ciliated cell of the respiratory tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>respiratory ciliated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>respiratory multiciliated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>respiratory tract multiciliated cell</rdfs:label>
    </owl:Class>
