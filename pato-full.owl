        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An osmolarity quality inhering in a bearer by virtue of the total amount of ionic salts dissolved in the bearer.</owl:annotatedTarget>
