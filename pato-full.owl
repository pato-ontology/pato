        <oboInOwl:hasDbXref>GOC:bf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0879694238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:8314839</oboInOwl:hasDbXref>
