    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0104353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0104353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000617"/>
        <obo:IAO_0000115>A shape quality inhering in a bearer by virtue of the bearer being abruptly bent backward or abaxially downward.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
        <oboInOwl:creation_date>2026-09-18T00:00:00Z</oboInOwl:creation_date>
