    <!-- http://purl.obolibrary.org/obo/CL_0002375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000255"/>
