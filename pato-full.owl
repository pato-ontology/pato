        <oboInOwl:hasDbXref>NCIT:C33555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:277687007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sinoatrial_node</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005069</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Koch&apos;s node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SA nodal muscle tissue</oboInOwl:hasExactSynonym>
