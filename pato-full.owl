        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/RO_0002503"/>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>towards</oboInOwl:id>
        <rdfs:comment>Consider using RO:0002503 instead. See https://github.com/pato-ontology/pato/issues/454</rdfs:comment>
        <rdfs:label>obsolete towards</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


