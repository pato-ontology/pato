    <!-- http://purl.obolibrary.org/obo/PATO_0070031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0070033"/>
        <obo:IAO_0000115>A neuron projection quality that is a characteristic of neurons that project to the medulla oblongata from other brain regions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
