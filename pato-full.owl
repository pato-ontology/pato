        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A simple columnar epithelium that looks stratified but is not, because its cells are arranged with their nuclei at different levels.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Pseudostratified_columnar_epithelium</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://medical-dictionary.thefreedictionary.com/pseudostratified+epithelium</oboInOwl:hasDbXref>
