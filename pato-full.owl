    <!-- http://purl.obolibrary.org/obo/PATO_0001327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001324"/>
        <obo:IAO_0000115>A symmetry quality inhering in a bearer by virtue of the bearer&apos;s being capable of division into symmetrical halves by only one longitudinal plane passing through the axis.</obo:IAO_0000115>
