        <oboInOwl:hasExactSynonym>recurrent laryngeal nerve from vagus nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vagus X nerve recurrent laryngeal branch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>inferior laryngeal nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ramus recurrens</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003716</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
