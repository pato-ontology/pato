                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0003341"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cilium which may have a variable arrangement of axonemal microtubules and also contains molecular motors. It may beat with a whip-like pattern that promotes cell motility or transport of fluids and other cells across a cell surface, such as on epithelial cells that line the lumenal ducts of various tissues; or they may display a distinct twirling motion that directs fluid flow asymmetrically across the cellular surface to affect asymmetric body plan organization. Motile cilia can be found in single as well as multiple copies per cell.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0009434</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0031512</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>motile cilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>microtubule-based flagellum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>motile primary cilia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>motile primary cilium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>motile secondary cilium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nodal cilium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0031514</oboInOwl:id>
        <rdfs:label>motile cilium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0031514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cilium which may have a variable arrangement of axonemal microtubules and also contains molecular motors. It may beat with a whip-like pattern that promotes cell motility or transport of fluids and other cells across a cell surface, such as on epithelial cells that line the lumenal ducts of various tissues; or they may display a distinct twirling motion that directs fluid flow asymmetrically across the cellular surface to affect asymmetric body plan organization. Motile cilia can be found in single as well as multiple copies per cell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cilia</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:kmv</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17009929</oboInOwl:hasDbXref>
