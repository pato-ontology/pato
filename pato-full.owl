        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The red vascular substance consisting of connective tissue and blood vessels, containing primitive blood cells, macrophages, megakaryocytes, and fat cells. Red marrow is found in the cavities of many bones. It manufactures and releases leukocytes and erythrocytes into the bloodstream.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://medical-dictionary.thefreedictionary.com/red+marrow</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
