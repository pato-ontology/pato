        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">acts on population of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012008 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012008">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002592"/>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-26T07:28:29Z</oboInOwl:creation_date>
