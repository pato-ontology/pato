        <oboInOwl:hasRelatedSynonym>cardiomyocyte generation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0010002</oboInOwl:id>
        <rdfs:label>cardioblast differentiation</rdfs:label>
    </owl:Class>
