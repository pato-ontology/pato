        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>Requested for FLOPO; corresponding temporary class: FLOPO_0985003. Distinguished from the curvature qualities recurved (PATO:0002211) and retrorse (PATO:0002237): a reflexed bearer is bent at an angle rather than curved.</rdfs:comment>
        <rdfs:label>reflexed</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0104353"/>
