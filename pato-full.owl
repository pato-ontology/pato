        <oboInOwl:creation_date>2013-12-19T15:25:51Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId>GO:1902589</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Reactome:R-HSA-1852241</oboInOwl:hasDbXref>
