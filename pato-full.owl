        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0000959</oboInOwl:id>
        <rdfs:label>mitochondrial RNA metabolic process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
