        <oboInOwl:hasDbXref>VHOG:0000502</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Aorticopulmonary_septum</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>aortico-pulmonary septum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>aorticopulmonary septum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>aortic septum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>spiral septum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006207</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#emapa_ehdaa2"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>aortico-pulmonary spiral septum</rdfs:label>
    </owl:Class>
