    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0070029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0070033"/>
        <obo:IAO_0000115>A neuron projection quality that is a characteristic of neurons with soma in the cerebral cortex and projections to the thalamus.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasDbXref>ILX:0770102</oboInOwl:hasDbXref>
