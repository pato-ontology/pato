        <rdfs:label>allohexaploid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0103304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0103304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0103302"/>
        <obo:IAO_0000115>An allotetraploid quality inhering in a bearer by virtue of the bearer&apos;s two parental subgenomes being only partially differentiated (partially homeologous).</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9076-6066"/>
        <oboInOwl:creation_date>2026-06-17T22:04:36Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0103304</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#cell_quality"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/pato#value_slim"/>
        <rdfs:comment>The two parental subgenomes are partially homeologous, producing inconsistent chromosome pairing. Cultivated peanut (Arachis hypogaea) is an example.</rdfs:comment>
        <rdfs:label>segmental allotetraploid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0103304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An allotetraploid quality inhering in a bearer by virtue of the bearer&apos;s two parental subgenomes being only partially differentiated (partially homeologous).</owl:annotatedTarget>
