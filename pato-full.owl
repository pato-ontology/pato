        <obo:IAO_0000115>A pyramidal cell morphology that inheres in neurons which have an apical tree which is oriented towards the white matter.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasDbXref>ilxtr:InvertedPyramidalPhenotype</oboInOwl:hasDbXref>
