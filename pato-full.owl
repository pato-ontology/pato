        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <obo:IAO_0000115>OBSOLETE. q1 decreased_in_magnitude_relative_to q2 if and only if magnitude(q1) &lt; magnitude(q2). Here, magnitude(q) is a function that maps a quality to a unit-invariant scale.</obo:IAO_0000115>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/RO_0015008"/>
