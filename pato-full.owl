        <obo:IAO_0000115>A glial cell that myelinates or ensheathes axons in the peripheral nervous system.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-03-02T01:19:27Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>BTO:0001220</oboInOwl:hasDbXref>
