        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_flybase_ribbon"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_metagenomics"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_mouse"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_plant"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_plant_ribbon"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_prokaryote"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_prokaryote_ribbon"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
        <rdfs:comment>Note that this term is intended to annotate gene products that are not attached to the cell surface. For gene products at the cell surface, consider annotating to external side of plasma membrane ; GO:0009897.</rdfs:comment>
        <rdfs:label>extracellular region</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0140392"/>
        <obo:IAO_0000115>A highly soluble, elongated protein complex found in blood plasma and involved in clot formation. It is converted into fibrin monomer by the action of thrombin. In the mouse, fibrinogen is a hexamer, 46 nm long and 9 nm maximal diameter, containing two sets of nonidentical chains (alpha, beta, and gamma) linked together by disulfide bonds.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>fibrinogen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen alpha chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen beta chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>fibrinogen gamma chain</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005577</oboInOwl:id>
        <rdfs:label>fibrinogen complex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A highly soluble, elongated protein complex found in blood plasma and involved in clot formation. It is converted into fibrin monomer by the action of thrombin. In the mouse, fibrinogen is a hexamer, 46 nm long and 9 nm maximal diameter, containing two sets of nonidentical chains (alpha, beta, and gamma) linked together by disulfide bonds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0198547684</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005581">
