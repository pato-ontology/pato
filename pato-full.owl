    <!-- http://purl.obolibrary.org/obo/CL_0000540 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000540">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020104"/>
