        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043501"/>
        <obo:IAO_0000115>The enlargement or overgrowth of all or part of an organ due to an increase in size (not length) of individual muscle fibers without cell division. In the case of skeletal muscle cells this happens due to the additional synthesis of sarcomeric proteins and assembly of myofibrils.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014734</oboInOwl:id>
        <rdfs:label>skeletal muscle hypertrophy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
