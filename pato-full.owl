        <oboInOwl:hasDbXref>PATOC:MAH</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0020001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0020001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0020000"/>
        <obo:IAO_0000115>A biological sex quality inhering in an individual based upon genotypic composition that confers the capability for an organism to differentiate male gonads.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4148-4606"/>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0020001</oboInOwl:id>
        <rdfs:comment>Note that the chromosomal constitution of genotypic sex varies in different organisms. In human, this would be XY, though abnormal XXY and XYY would also result in a male phenotypic outcome.</rdfs:comment>
        <rdfs:label>male genotypic sex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0020001"/>
