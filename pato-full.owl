        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0003162</oboInOwl:id>
        <rdfs:label>atrioventricular node development</rdfs:label>
    </owl:Class>
